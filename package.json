    "@supabase/supabase-js": "^2.117.3",
    "@types/pg": "^8.23.1",
    "expo": "~57.0.15",
    "expo-constants": "^57.0.22",
    "expo-linear-gradient": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "pg": "^8.23.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@playwright/test": "^1.64.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "prisma": "^5.22.0",
    "serve": "^14.2.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --port 8081",
